rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visits/{visitId} {
      allow read, write: if request.auth != null;
    }
    match /meta/{docId} {
      allow read: if request.auth != null;
    }
    // Rastros de exclusão: o app grava aqui quando uma visita ligada ao Google Agenda é
    // excluída, e o sync do servidor apaga o evento correspondente e remove o rastro.
    // O servidor usa o Admin SDK, que ignora estas regras — elas só liberam o navegador.
    match /googleDeletions/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
